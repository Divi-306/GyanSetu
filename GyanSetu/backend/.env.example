NODE_ENV=development
PORT=4000
# Base URL for signed download links. In development the API uses the address the phone
# connected to, so this only matters in production (set it to the public HTTPS URL).
PUBLIC_BASE_URL=http://localhost:4000

DATABASE_URL=postgres://gyansetu:gyansetu@localhost:5435/gyansetu
DATABASE_SSL=false

# Generate each with:  node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=change-me-to-a-long-random-string-at-least-32-chars
PACK_URL_SECRET=change-me-to-another-long-random-string-32-chars

ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=90

CORS_ORIGINS=*
PACK_STORAGE_DIR=./storage/packs
MEDIA_SOURCE_DIR=./storage/media

# AI tutor. AI_PROVIDER is groq, xai (Grok) or anthropic (Claude); set that provider's key.
# AI_MODEL is optional: defaults to openai/gpt-oss-120b (groq), grok-4.7 (xai) or claude-opus-5 (anthropic).
AI_PROVIDER=groq
GROQ_API_KEY=
XAI_API_KEY=
ANTHROPIC_API_KEY=
AI_MODEL=
# AI Navigator model. Blank = openai/gpt-oss-20b on Groq (fast; separate from the tutor model).
NAVIGATOR_MODEL=

# Google sign-in (optional). Comma-separated OAuth client IDs (Android, iOS, Web)
# Learning-pack videos: wikimedia needs no key; youtube is used only when a key is set (stream-only).
# How many module-writing AI calls run in parallel per pack. Keep at 1 unless your AI
# provider key has a generous tokens-per-minute limit (a free/low-tier key can be as low
# as a few thousand TPM, and one module call alone can use several thousand tokens).
PACK_MODULE_CONCURRENCY=1
# Hard ceiling on tokens requested per Groq call. Groq rejects a request outright the
# instant its own requested max tokens exceeds the account's per-minute token budget
# (one number shared by every model) — no retry fixes that. Default leaves headroom
# under a typical free/low-tier 8,000 TPM cap. Check x-ratelimit-limit-tokens on any
# Groq response to see your key's real limit, and raise this only if it's higher.
GROQ_MAX_TOKENS_PER_REQUEST=6000
# How many learning packs a student can generate per day.
PACK_GENERATION_DAILY_LIMIT=30

VIDEO_SOURCES=wikimedia,youtube
YOUTUBE_API_KEY=

GOOGLE_CLIENT_IDS=

# Email (optional). If empty, reset links are printed to the console in dev.
SMTP_URL=
MAIL_FROM=GyanSetu <no-reply@gyansetu.app>
APP_RESET_URL=gyansetu://reset-password
